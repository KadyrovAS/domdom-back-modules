              <stringProp name="script">// Получаем код ответа от сервера
String responseCode = prev.getResponseCode();

// Если код ответа 409 (Conflict), считаем, что тест пройден успешно
if (responseCode.equals(&quot;409&quot;)) {
    // Устанавливаем флаг, что тест успешен
    prev.setSuccessful(true);
    // Логируем факт игнорирования 409 для отладки
    log.info(&quot;Ignore 409 response for favorite: &quot; + prev.getSampleLabel());
}</stringProp>
